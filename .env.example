# Firma de cookies. Mínimo 16 caracteres. Genera uno largo y no lo subas.
SESSION_SECRET=cambia-esto-por-un-secreto-largo

# Año al que redirige /
CURRENT_YEAR=2026

# Contraseña de cada edición. El cliente nunca la ve.
ACCESS_PASSWORD_2026=cambia-esta-clave

# Panel /admin
ADMIN_PASSWORD=cambia-admin

# Opcional. Permite ?debug=2026-10-05T00:00:00-07:00&key=ESTE_VALOR
# También vale si ya hay cookie de admin.
DEBUG_SECRET=cambia-debug

# Turso / libSQL (https://turso.tech)
TURSO_DATABASE_URL=libsql://xxxx-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJ...
